{
  "name": "niimbot-labels",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "app:dev": "BIRKA_DEV_URL=http://127.0.0.1:5173 electron .",
    "app:build": "npm run build && electron-builder --mac dir",
    "app:install": "sh scripts/install-app.sh"
  },
  "build": {
    "appId": "dev.rudnik.birka",
    "productName": "Бирка",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Бирка печатает наклейки на принтере NIIMBOT по Bluetooth.",
        "NSBluetoothPeripheralUsageDescription": "Бирка печатает наклейки на принтере NIIMBOT по Bluetooth."
      }
    }
  },
  "dependencies": {
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mmote/niimbluelib": "0.46.0",
    "@preact/signals": "2.11.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/web-bluetooth": "0.0.21",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
